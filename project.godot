; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Nam Bắc Phân Tranh"
config/description="RTS Trịnh – Nguyễn phân tranh, lối chơi Cossacks 3, ưu tiên điện thoại Android."
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
RngService="*res://scripts/autoload/rng_service.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
Session="*res://scripts/autoload/session.gd"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=1688
window/size/viewport_height=780
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=20
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.08, 0.07, 0.06, 1)
